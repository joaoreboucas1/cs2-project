\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textcolor {teal}{[{\bf  Edit}: Solutions for $\mu (k,a)$ from Equations~\ref {eq:braiding_ode} and~\ref {eq:mg_mu_k} for the four parameterizations of $\alpha _{\rm  K}$ considered (columns) and $c_s^2 = 0.75, 1, 1.25$ (rows), assuming $\lambda _\mathrm  {MG} = 1$. Colored lines show $k = 10^{-4}$, $3\times 10^{-4}$ and $10^{-3}\,h/\mathrm  {Mpc}$, while the black dotted line shows the $k \rightarrow \infty $ limit, which coincides with the QSA expression. We assume $w_0 = -0.838$ and $w_a = -0.62$ for the $\alpha _\mathrm  {K} \propto \Omega _\mathrm  {DE}$ and $\alpha _\mathrm  {K} \propto \alpha _\mathrm  {B}$ cases. For the Cubic Galileon-like and k-essence-like cases, we assume $w_0 = -0.9$ and $w_a = -0.1$, since a phantom-crossing equation of state leads to a pole in $\mu (k,a)$ for the former and to unstable perturbations for the latter.]}}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:mu_examples}{{1}{6}{\edit {Solutions for $\mu (k,a)$ from Equations~\ref {eq:braiding_ode} and~\ref {eq:mg_mu_k} for the four parameterizations of $\alpha _{\rm K}$ considered (columns) and $c_s^2 = 0.75, 1, 1.25$ (rows), assuming $\lambda _\mathrm {MG} = 1$. Colored lines show $k = 10^{-4}$, $3\times 10^{-4}$ and $10^{-3}\,h/\mathrm {Mpc}$, while the black dotted line shows the $k \rightarrow \infty $ limit, which coincides with the QSA expression. We assume $w_0 = -0.838$ and $w_a = -0.62$ for the $\alpha _\mathrm {K} \propto \Omega _\mathrm {DE}$ and $\alpha _\mathrm {K} \propto \alpha _\mathrm {B}$ cases. For the Cubic Galileon-like and k-essence-like cases, we assume $w_0 = -0.9$ and $w_a = -0.1$, since a phantom-crossing equation of state leads to a pole in $\mu (k,a)$ for the former and to unstable perturbations for the latter.}}{figure.1}{}}
